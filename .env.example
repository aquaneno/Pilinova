# Host-IP für den veröffentlichten Docker-Port.
# Für eine bestimmte Schnittstelle durch deren vorhandene Host-IP ersetzen,
# zum Beispiel 192.168.1.50. 0.0.0.0 bindet an alle IPv4-Adressen.
BIND_ADDRESS=127.0.0.1

# Port auf dem Host; der interne Container-Port bleibt 8080.
PORT=8080

# Admin unter /admin. Ohne Hash bleibt der Zugang gesperrt.
ADMIN_USERNAME=admin
# Mit python3 server.py --hash-admin-password erzeugen.
# Den Hash in EINFACHE Anführungszeichen setzen, damit Compose $ nicht ersetzt:
ADMIN_PASSWORD_HASH=''
# Bei HTTPS hinter Nginx/Cloudflare true lassen. Nur für lokale HTTP-Tests false.
ADMIN_COOKIE_SECURE=true
